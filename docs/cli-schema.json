{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYX-RS Envelope",
  "description": "Every `ayx` JSON result is one complete, recursively redacted envelope. It is the default when stdout is not a terminal or an agent host is detected.",
  "$ref": "#/$defs/FullEnvelope",
  "$defs": {
    "FullEnvelope": {
      "type": "object",
      "required": ["ok", "message", "timestamp_utc", "data"],
      "properties": {
        "ok": { "type": "boolean" },
        "command": {
          "type": "string",
          "description": "Dotted id of the command that produced the envelope, such as `one.jobs.runs`. Present on the success and failure envelopes of every parsed command, and omitted rather than guessed when no command was resolved. It is the key that correlates a result with its invocation."
        },
        "message": { "type": "string" },
        "timestamp_utc": { "type": "string", "format": "date-time" },
        "data": {},
        "error_code": { "$ref": "#/$defs/ErrorCode" },
        "remediation": { "$ref": "#/$defs/Remediation" },
        "retryable": { "type": "boolean" },
        "next": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "config_missing", "auth_failed", "permission_denied", "not_found", "gone",
        "validation", "conflict", "rate_limited", "network", "upstream",
        "workspace_mismatch", "incomplete", "output_classification", "internal"
      ]
    },
    "Remediation": {
      "type": "object",
      "required": ["summary", "commands"],
      "properties": {
        "summary": { "type": "string" },
        "commands": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
